# Logging
LOG_LEVEL=INFO

# Retriva Client
# RETRIVA_ADAPTER is a configuration setting that tells the retriva-eval
# framework which part of the Retriva architecture it should communicate
# with during evaluation.
# Currently, it supports two valid modes:
#
# gateway_http (default): The framework will communicate with the Retriva Gateway.
# It will use the endpoints defined in the GATEWAY_* environment variables 
# (e.g., /gateway/chat for answering queries and /gateway/ingestion for uploading 
# documents).
#
# core_openai_chat: The framework will bypass the Gateway and communicate
# directly with Retriva Core. It will send OpenAI-compatible payloads to 
# the endpoints defined in the CORE_* environment variables 
# (e.g., /v1/chat/completions for querying and /v1/ingest for uploading
# documents).
RETRIVA_ADAPTER=gateway_http
RETRIVA_TIMEOUT_SECONDS=60
RETRIVA_DEFAULT_TOP_K=5

# Gateway
GATEWAY_BASE_URL=http://localhost:8002
GATEWAY_CHAT_PATH=/gateway/chat
GATEWAY_INGESTION_PATH=/gateway/ingestion
GATEWAY_KBS_PATH=/gateway/kbs

# Core
CORE_CHAT_BASE_URL=http://localhost:8001
CORE_INGESTION_BASE_URL=http://localhost:8000
CORE_CHAT_PATH=/v1/chat/completions
CORE_INGESTION_PATH=/api/v2/documents/upload

# Evaluation
EVAL_KNOWLEDGE_BASE=eval-ragas-sample-markdown
EVAL_METADATA={"retriva_eval": "true", "suite": "ragas_sample_markdown"}
EVAL_METADATA_FILTERING_MODE=hard
EVAL_REPORTS_DIR=reports
EVAL_FAIL_ON_THRESHOLD_BREACH=true

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=retriva_eval_manual

# LLM
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
AZURE_OPENAI_API_KEY=
